{
  "schemaVersion": 1,
  "id": "Church",
  "name": "Church",
  "version": "1.0.1",
  "description": "Recreates the LiF:MMO church for LiF:YO. Patches cm_objects.xml (adds the church object) and skill_types.xml (adds object 2485 to 5 ability ent_reqs).",
  "authors": [
    "lif-x community"
  ],
  "loadOrderHint": 100,
  "files": {
    "overlay": [
      {
        "src": "mods/",
        "dest": "mods/"
      },
      {
        "src": "yolauncher/",
        "dest": "yolauncher/"
      }
    ],
    "dataPatches": [
      {
        "target": "data/cm_objects.xml",
        "replace": "data/cm_objects.xml"
      },
      {
        "target": "data/skill_types.xml",
        "replace": "data/skill_types.xml"
      }
    ]
  }
}